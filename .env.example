# OpenAI API Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=anthropic/claude-sonnet-4

# 生成"对话摘要"用的模型（压缩上下文时用）。
# 留空则沿用 OPENAI_MODEL。摘要任务不复杂，配一个便宜的小模型能明显省钱。
OPENAI_SUMMARY_MODEL=

# 是否给消息打 Anthropic 的提示词缓存标记（cache_control）：
#   1    强制开启
#   0    强制关闭
#   留空 自动判断（接口地址含 anthropic 或模型名含 claude 时才开）
# 注意：OpenAI 官方接口不认这个字段，自动判断就是防止请求被拒。
ENABLE_PROMPT_CACHE=

# 单条工具输出写进对话历史时的最大字符数，超出会掐头去尾并提示模型分段读取。
MAX_TOOL_OUTPUT_CHARS=12000

# The unit is k
MODEL_MAX_TOKENS=200
COMPRESS_THRESHOLD=0.8
