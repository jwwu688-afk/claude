# =============================================================================
# 配置模板。复制成 .env 后填上自己的值：cp .env.example .env
#
# 键名、顺序、注释与项目根目录的 .env 保持一致（只差具体值）。
# 下面三项必填，缺任何一项 APIClient 初始化就会直接抛 ValueError。
# =============================================================================

# 接口密钥
OPENAI_API_KEY=your_api_key_here

# OpenAI 兼容接口地址。
#   多数厂商要求以 /v1 结尾：OpenAI 官方 api.openai.com/v1、OpenRouter xxx/api/v1、
#   绝大多数中转站也是 /v1（实测随想网关不带 /v1 会 404）。
#   但也有厂商两种都认：DeepSeek 的 api.deepseek.com 与 api.deepseek.com/v1 都能用。
#   判断方法：报 404 Not Found 而不是 401 时，先怀疑这里少写了 /v1；报 401 才是 key 的问题。
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名，按实际接口填。模型必须支持 function calling（工具调用），
# 否则它只会聊天、不会读写文件、不会执行命令。
OPENAI_MODEL=gpt-4o-mini

# 【/model 命令的兜底清单】逗号分隔的模型名，例：gpt-4o-mini,claude-3-5-sonnet,deepseek-chat
# /model 会先请求接口的 /v1/models 拿清单；接口不支持（很多中转站没有这个路由）
# 或请求失败时，就退回用这一行。留空表示"接口列不出来时 /model 就没法用"——
# 这条命令只能从清单里选，没有"直接打名字"的用法，所以接口不支持时最好把候选写在这里。
# 注意：这只是命令里给你选的候选，不影响实际发起请求——
#   真正生效的是上面的 OPENAI_MODEL（启动时读一次）和会话内 /model 的切换。
OPENAI_MODELS=

# 生成"对话摘要"用的模型（压缩上下文时用）。
# 留空则沿用 OPENAI_MODEL。摘要任务不复杂，配个便宜的小模型能明显省钱。
OPENAI_SUMMARY_MODEL=

# 是否给消息打 Anthropic 的提示词缓存标记（cache_control）：
#   1    强制开启
#   0    强制关闭
#   留空 自动判断（接口地址含 anthropic 或模型名含 claude 时才开）
# 注意：OpenAI 官方接口不认这个字段，自动判断就是防止请求被拒。
ENABLE_PROMPT_CACHE=

# 单条工具输出写进对话历史时的"兜底上限"（字符数），超出会掐头去尾。
# 必须 >= 各工具自己的业务上限，否则业务上限就是假的：
#   file_read 一次最多 2000 行，正常代码文件约 3~6 万字符，
#   设成 12000 会让一次正常读文件被腰斩，模型只能反复带 offset 重读，反而更贵。
# 与 core/limits.py 的默认值（30000）保持一致。
MAX_TOOL_OUTPUT_CHARS=30000

# 【五层压缩 L3】工具结果折叠阈值（字符数）。
# 对话变长后，较早的「可重复查询」工具（file_read/file_grep/file_glob 等读操作）
# 结果会被折叠成一句中文占位 "[更早的工具结果已折叠，需要完整内容时请重新运行对应工具。]"。
# 只有超过这个值的工具结果才折叠，小结果原样保留。有副作用的工具（写/执行）不折叠。
MICROCOMPACT_TOOL_OUTPUT_CHARS=8000

# 上下文窗口上限，单位是 k（200 表示约 20 万 token）。
# 填错只影响"上下文占用百分比"算得准不准，不会让请求失败。
MODEL_MAX_TOKENS=200

# 用到多少比例开始自动压缩上下文
COMPRESS_THRESHOLD=0.8

# 【五层压缩】四档区间映射（比例，0~1）。按"上下文占用比例"落点直做：
# 落在哪一档，就只做那一档对应的动作，不爬层、不叠加：
#   占用 < 0.80            → 不压缩
#   占用 [0.80, 0.85)      → L2 Snip：保头+尾47、剪中间（零成本，不调模型）
#   占用 [0.85, 0.90)      → L3 Microcompact：旧工具结果二次瘦身（零成本，不调模型）
#   占用 [0.90, 0.95)      → L4 Context Collapse：只读投影（零成本，不调模型）
#   占用 >= 0.95           → L5 Auto-compact：调模型全量摘要（最贵，兜底）
# 四个阈值共同划出五段区间，压力越大、手段越重。须满足 0.8 <= 0.85 <= 0.9 <= 0.95。
SNIP_THRESHOLD=0.85
MICRO_THRESHOLD=0.90
COLLAPSE_THRESHOLD=0.95

# =============================================================================
# 界面调试开关（平时留空；只有界面出怪问题、或换了奇怪的终端时才需要）
# =============================================================================

# 流式渲染模式。默认 plain（逐行追加，跨终端稳定）；
#   设 live 回到早期的 rich.Live 实时渲染——字更平滑，但部分终端会出现重影。
#   注意它管的是"怎么画"，不是"要不要流式"。
THINKER_STREAM=

# 设 1 则退回最朴素的 input()：Tab 补全、多行编辑、Esc 打断全部消失。
#   用途：自绘输入层在某个终端/输入法下彻底错乱时，先保证能把话说完。
THINKER_PLAIN_INPUT=

# 设 1 彻底关掉等待动画。用于远程 SSH、日志重定向、录屏，
#   避免 spinner 反复写 \r 把输出搞花。
THINKER_NO_SPINNER=

# 输入区下方预留的空白行数（整数）。不设时按窗口高度的一半动态算，
#   设了就用固定值——窗口特别高/特别矮、或录屏想要固定构图时用。
THINKER_INPUT_PADDING=
